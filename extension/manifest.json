{
  "manifest_version": 3,
  "name": "Trae Token Watcher",
  "version": "0.1.0",
  "description": "监控 TRAE Work Token 消耗，AI 驱动积分优化建议",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://work.trae.cn/*",
    "https://www.trae.cn/*",
    "https://api.deepseek.com/*"
  ],
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://work.trae.cn/*", "https://www.trae.cn/*"],
      "js": ["content/inject.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://work.trae.cn/*", "https://www.trae.cn/*"],
      "js": ["content/content.js"],
      "world": "ISOLATED",
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Trae Token Watcher"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
